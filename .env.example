# Documentation only: the launcher does not load this file.
# Offline preview needs no credentials or Azure account.
CHANGEGUARD_MODE=local-fixture
PUBLIC_ORIGIN=http://127.0.0.1:8033

# Optional live server configuration. Replace every placeholder explicitly.
# CHANGEGUARD_MODE=live-azure
# PUBLIC_ORIGIN=https://<your-application-host>
# OPERATOR_TOKEN_SHA256=<sha256-of-your-high-entropy-application-operator-token>
# SESSION_SIGNING_KEY=<independent-random-signing-key-at-least-32-characters>
# SPEECH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<speech-account>
# SPEECH_HOST=<speech-custom-subdomain>.cognitiveservices.azure.com
# SPEECH_REGION=<supported-azure-region>
# CHANGEGUARD_DATA_DIR=<private-persistent-directory>

# Optional deployment/evaluation commands, supplied through your secret manager.
# AZURE_SUBSCRIPTION_ID=<your-explicit-subscription-id>
# AZURE_RESOURCE_GROUP=rg-changeguard
# AZURE_LOCATION=<supported-azure-region>
# CHANGEGUARD_OPERATOR_TOKEN=<your-high-entropy-application-operator-token>
